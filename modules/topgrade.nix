{ lib, ... }:

let

  # The Nix side of the system is deliberately absent (no "nix" step): nix
  # itself and the profile are pinned by the declarative config, so topgrade
  # must not upgrade them behind the flake's back.
  baseSteps = [
    "system" # distro package manager (a no-op on NixOS)
    "tldr" # tldr pages cache
    "firmware" # fwupd
    "flatpak" # flatpak (system + user)
    "brew_formula" # homebrew formulae
    "brew_cask" # homebrew casks
    "distrobox" # distrobox containers
  ];

  onlyLines = lib.concatMapStringsSep "\n" (s: "      \"${s}\",") baseSteps;

in
{
  xdg.configFile."topgrade.toml" = {
    force = true;
    text = ''
            # Topgrade — Nix-first config.
            #
            # Generated by modules/topgrade.nix; the wsl flavor appends a [commands]
            # entry that refreshes Home Manager (which owns the CLI bundles too — a
            # NixOS host gets the equivalent for free from `nixos-rebuild switch`).
            #
            # Restricts updates to a small, headless-friendly set. Steps whose tool
            # isn't installed are skipped automatically. Step names are topgrade's
            # snake_case identifiers; run `topgrade --dry-run` to preview.

            [misc]
            only = [
      ${onlyLines}
            ]

            assume_yes = true
            skip_notify = true
            cleanup    = true
    '';
  };
}
