#!/usr/bin/env bash
#
# devshell-init — copy one of the Nix devShell templates (see
# devshell-templates/) into another repo you're working on.
#
# Usage:
#   devshell-init <template-name> [target-dir]   # target-dir defaults to .
#   devshell-init                                # list available templates
#   devshell-init <template-name> --force        # allow overwriting existing files
#
# Files are dropped at the target's ROOT (flake.nix, .envrc,
# .config/dotnet-tools.json) — that's how Nix devShells are meant to sit.
# README.md is deliberately NOT copied (scaffolder-only reference docs), and
# .dev.local.sh.example is auto-materialized into .dev.local.sh (the
# per-developer hook — NVIM_LANGS etc. live there, not in .envrc) rather
# than copied verbatim.
#
# Templates are looked up in $DEVSHELL_TEMPLATES_DIR (default:
# ~/.local/share/devshell-templates), which is materialized by
# ~/repos/home-manager (modules/scripts.nix).

set -euo pipefail

TEMPLATES_DIR="${DEVSHELL_TEMPLATES_DIR:-$HOME/.local/share/devshell-templates}"

_list_templates() {
  echo "Available templates (from $TEMPLATES_DIR):"
  if [[ ! -d "$TEMPLATES_DIR" ]]; then
    echo "  (templates dir missing — run 'home-manager switch' to materialize)"
    return
  fi
  for dir in "$TEMPLATES_DIR"/*/; do
    [[ -d "$dir" ]] || continue
    echo "  - $(basename "$dir")"
  done
}

FORCE=false
ARGS=()
for arg in "$@"; do
  case "$arg" in
  --force) FORCE=true ;;
  *) ARGS+=("$arg") ;;
  esac
done

if [[ "${#ARGS[@]}" -lt 1 ]]; then
  _list_templates
  exit 0
fi

TEMPLATE_NAME="${ARGS[0]}"
TARGET_DIR="${ARGS[1]:-.}"
TEMPLATE_SRC="$TEMPLATES_DIR/$TEMPLATE_NAME"

if [[ ! -d "$TEMPLATE_SRC" ]]; then
  echo "ERROR: Unknown template '$TEMPLATE_NAME'." >&2
  _list_templates >&2
  exit 1
fi

mkdir -p "$TARGET_DIR"

# Refuse to clobber a repo that already has a flake.nix / .envrc / dotnet
# manifest unless explicitly forced. These are the sentinels most likely to
# indicate the repo already has a devShell of its own.
if [[ "$FORCE" != true ]]; then
  for sentinel in flake.nix .envrc .config/dotnet-tools.json; do
    if [[ -e "$TARGET_DIR/$sentinel" ]]; then
      echo "ERROR: $TARGET_DIR/$sentinel already exists. Pass --force to overwrite." >&2
      exit 1
    fi
  done
fi

# Copy template contents (dotfiles included) into the target root.
#
# Every file under $TEMPLATES_DIR is itself a symlink into the Nix store
# (home.file with recursive=true symlinks leaves, not the whole tree), so a
# plain recursive cp preserves those symlinks verbatim — the target repo
# ends up with dangling-on-other-machines links back into /nix/store instead
# of real files. `-L` dereferences every symlink into real content;
# `--no-preserve=mode` drops the store's read-only 444 so the copies land as
# normal writable files.
#
# README.md is intentionally skipped: it's scaffolder/reference
# documentation, not something a consuming repo needs to carry around. It
# stays readable from $TEMPLATE_SRC/README.md instead.
#
# .dev.local.sh.example is also handled separately below, so it can be
# auto-materialized into .dev.local.sh rather than left as a manual step.
shopt -s dotglob
for entry in "$TEMPLATE_SRC"/*; do
  base="$(basename "$entry")"
  case "$base" in
  README.md | .dev.local.sh.example) continue ;;
  esac
  cp -rL --no-preserve=mode "$entry" "$TARGET_DIR/$base"
done
shopt -u dotglob

echo "Copied '$TEMPLATE_NAME' template into $TARGET_DIR"

# Auto-materialize the personal dev hook from the template's example, so
# NVIM_LANGS and friends are wired up with zero manual steps. Never
# clobbers an existing .dev.local.sh (it's gitignored/personal — you may
# have already edited it), even under --force.
DEV_LOCAL_NOTE=""
if [[ -f "$TEMPLATE_SRC/.dev.local.sh.example" ]]; then
  if [[ -f "$TARGET_DIR/.dev.local.sh" ]]; then
    DEV_LOCAL_NOTE="  - $TARGET_DIR/.dev.local.sh already exists — left untouched."
  else
    cp -L --no-preserve=mode "$TEMPLATE_SRC/.dev.local.sh.example" "$TARGET_DIR/.dev.local.sh"
    chmod +x "$TARGET_DIR/.dev.local.sh"
    DEV_LOCAL_NOTE="  - Personal hook ready at $TARGET_DIR/.dev.local.sh (NVIM_LANGS + personal tools — edit freely, gitignored)."
  fi
fi

echo ""
echo "Next steps:"
echo "  - Append to $TARGET_DIR/.gitignore:"
echo "      /.certs/"
echo "      /.dev.local.sh"
echo "      /.direnv/"
echo "      /.envrc.local"
echo "      /.config/.tools-restored"
echo "  - Trust the dev cert on this host (one-off):"
echo "      dotnet dev-certs https --trust"
echo "  - Enter the shell:  direnv allow   (or: nix develop)"
if [[ -n "$DEV_LOCAL_NOTE" ]]; then
  echo "$DEV_LOCAL_NOTE"
fi
echo "  - Read $TEMPLATE_SRC/README.md for template-specific gotchas."
